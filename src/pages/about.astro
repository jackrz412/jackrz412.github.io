---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlinkCursor from '../components/BlinkCursor.astro';
// The bio lives with the rest of the site's words, kept apart from the layout.
import home from '../data/home.json';
---

<BaseLayout title={`About | ${home.name}`} description={home.tagline}>
  <h1>About me<BlinkCursor /></h1>
  <p>{home.bio}</p>

  <!-- Two square photos, stripped of their metadata before being added to public/. -->
  <div class="photos">
    <img
      src="/images/about/portrait.jpg"
      width="800"
      height="800"
      loading="lazy"
      alt="Black and white portrait of Jack in a white T-shirt."
    />
    <img
      src="/images/about/los-alamos.jpg"
      width="800"
      height="800"
      loading="lazy"
      alt="Jack standing at dusk outside a white guard post, under a large sign reading Los Alamos Project Main Gate."
    />
  </div>
</BaseLayout>

<style>
  /* Side by side on wide screens, stacked on phones. */
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-sizing: border-box; /* the width includes the border, or the photo overflows its slot */
  }
</style>
