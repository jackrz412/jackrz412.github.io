---
// Results page for the Local LLM Lab benchmark.
// All numbers come from summary.json, exported by Local_LLM_Lab/scripts/export_summary.py.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlinkCursor from '../../components/BlinkCursor.astro';
import ModelKey from '../../components/ModelKey.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import SectionNav from '../../components/SectionNav.astro';
import SpeedRace from '../../components/SpeedRace.astro';
import summary from '../../data/llm-lab/summary.json';

const repoUrl = 'https://github.com/jackrz412/local_llm_lab';
const scorecardUrl = `${repoUrl}/blob/main/results/run2/Analyzed%20Results/scorecard.txt`;

const models = summary.models;
const byName = Object.fromEntries(models.map((m) => [m.name, m]));
const fastest = byName['llama3.2:3b']; // tied with phi4-mini on seconds per correct answer
const phi4 = byName['phi4-mini'];
const gemma = byName['gemma3:12b'];
const qwen = byName['qwen3.5:9b']; // the most accurate, and the only thinking model

const totalAnswers = models.reduce((sum, m) => sum + m.pass_rates.all.strict.total, 0);
const timeRatio = Math.round(qwen.seconds_per_correct / fastest.seconds_per_correct);
const totalFails = models.reduce(
  (sum, m) => sum + Object.values(m.failure_modes).reduce((a, b) => a + b, 0),
  0,
);
const formatFails = models.reduce((sum, m) => sum + (m.failure_modes.format ?? 0), 0);
const formatFailPct = Math.round((formatFails / totalFails) * 100);
// Average seconds per answer before the answer starts, for qwen and for the slowest other model.
const qwenTotalPerAnswer = Math.round(
  qwen.seconds_per_answer.before_answer + qwen.seconds_per_answer.writing_answer,
);
const othersMaxBefore = Math.max(
  ...models.filter((m) => m !== qwen).map((m) => m.seconds_per_answer.before_answer),
);
// Heatmap trends: passes on one prompt (or a set of prompts) summed over every model.
const prompts = summary.scorecard.prompts;
const promptPasses = (grid, ids) =>
  models.reduce(
    (sum, m) => sum + prompts.reduce((s, p, i) => s + (ids.includes(p.id) ? grid[m.name][i] : 0), 0),
    0,
  );
const generalIds = prompts.filter((p) => p.set === 'general').map((p) => p.id);
const generalTotal = generalIds.length * summary.runs_per_prompt * models.length;
const generalStrict = promptPasses(summary.scorecard.strict, generalIds);
const generalJson = promptPasses(summary.scorecard.json_accepted, generalIds);
const perPromptTotal = summary.runs_per_prompt * models.length;
const okunCode = promptPasses(summary.scorecard.strict, ['okun-code']);
const okunJsonStrict = promptPasses(summary.scorecard.strict, ['okun-json']);
const okunJsonAccepted = promptPasses(summary.scorecard.json_accepted, ['okun-json']);
---

<BaseLayout
  title="Local LLMs and the Humble Mac mini | Jack Roberts"
  description="Five open LLMs benchmarked on a 16 GB Mac: accuracy, speed, and why answers failed."
>
  <p><a href="/">← Home</a></p>
  <SectionNav />

  <!-- Headline + takeaway -->
  <header>
    <h1>Local LLMs and the Humble Mac mini<BlinkCursor /></h1>
    <hr class="results-rule under-title" />
    <p class="eyebrow under-title">Summary up front</p>
    <p>
      I built my own benchmark to see what open-weight models can actually do on modest hardware:
      a 16 GB Mac mini. Five models each answered 12 prompts three times, from everyday questions
      to junior-analyst economics, and I graded all {totalAnswers} answers against known correct results.
    </p>
  </header>

  <!-- Setup panel: benchmark, key figures, models -->
  <div class="intro-panel">
  <!-- About the benchmark -->
  <section id="the-benchmark">
    <h2>The Benchmark</h2>
    <p>
      I split the benchmark into two prompt sets covering nine question types. A general set
      (5 prompts) acts as a baseline of everyday tasks. A specialized set (7 prompts) is built
      around one economics problem, Okun's Law, and is graded against a regression I ran myself
      on public FRED data.
    </p>
    <p>Together they answer two questions:</p>
    <ol>
      <li>Can a local model reliably handle everyday tasks?</li>
      <li>Can the same model do the work of a junior economic analyst?</li>
    </ol>
    <p>
      Three question types (factual recall, JSON output, and a trap question with no real
      answer) appear in both sets, which makes them a direct comparison. If a model passes the
      general version and fails the economics version, the gap is domain knowledge, not basic
      ability.
    </p>
    <p>
      Each of the {models.length} models answered all 12 prompts {summary.runs_per_prompt} times,
      for {totalAnswers} graded answers. The results tell me which model to use for later
      projects, and where a model can't be trusted on its own. In these cases, manual
      verification will need to be done to ensure maximum accuracy.
    </p>
    <p>
      The whole method runs on a few Python scripts: one sends every prompt to each model
      through Ollama, and another grades the answers. Models are just a setting, so I can swap
      them out or add new ones and re-run the same benchmark for a direct comparison.
    </p>
  </section>

  <!-- Stat row -->
  <section id="key-figures" aria-labelledby="key-figures-title">
    <h2 id="key-figures-title">Key Figures</h2>
    <ul class="stat-tiles">
      <li><strong>{models.length}</strong> models</li>
      <li><strong>{totalAnswers}</strong> graded answers</li>
      <li><strong>{timeRatio}×</strong> time per correct answer, most accurate vs fastest</li>
      <li><strong>{formatFailPct}%</strong> of fails were format-only</li>
    </ul>
  </section>

  <!-- Model color key -->
  <section id="models-used" aria-labelledby="models-used-title">
    <h2 id="models-used-title">Models Used</h2>
    <ModelKey />
  </section>
  </div>

  <!-- Divider between setup and findings -->
  <hr class="results-rule" />
  <p class="eyebrow">Results</p>

  <!-- Finding 1 -->
  <section id="accuracy-vs-time">
    <h2>1. Accuracy and answer speed</h2>
    <p>
      <code class="model-name" data-model="qwen3.5:9b">qwen3.5:9b</code>, the only model that reasons before it answers,
      passed {qwen.pass_rates.all.strict.passed} of the {qwen.pass_rates.all.strict.total} answers,
      the most of any model. It needed {qwen.seconds_per_correct} seconds per correct answer,
      against {fastest.seconds_per_correct} for both <code class="model-name" data-model="llama3.2:3b">llama3.2:3b</code> and <code class="model-name" data-model="phi4-mini">phi4-mini</code>.
      Of the models that answer straight away, <code class="model-name" data-model="phi4-mini">phi4-mini</code>, one of the two smallest,
      was the most accurate, with {phi4.pass_rates.all.strict.passed} of {phi4.pass_rates.all.strict.total}.
    </p>
    <figure>
      <div id="chart-accuracy"></div>
      <figcaption>
        Each dot corresponds to one model. Higher is more accurate, and further left is faster per
        correct answer. The time axis is logarithmic: each step is a multiple, not a fixed number of seconds.
      </figcaption>
    </figure>
    <p>
      Most of that time goes on reasoning.
      On average, {Math.round(qwen.seconds_per_answer.before_answer)} of the {qwenTotalPerAnswer} seconds <code class="model-name" data-model="qwen3.5:9b">qwen3.5:9b</code> spent
      per answer passed before its answer even began. The other models started answering
      within {othersMaxBefore} seconds.
    </p>
    <figure>
      <div id="chart-time-split"></div>
      <figcaption>
        Average seconds per answer, split at the moment the answer starts. Before that, a model
        reads the prompt and, if it thinks, reasons. Answers cut off before they started count
        entirely as time before the answer.
      </figcaption>
    </figure>
  </section>

  <!-- Finding 2 -->
  <section id="scorecard">
    <h2>2. The scoreboard: total passes and fails</h2>
    <p>
      Of the {totalFails} fails, {formatFails} were correct JSON wrapped in a Markdown code
      block. Accept that, and <code class="model-name" data-model="gemma3:12b">gemma3:12b</code> passes {gemma.pass_rates.all.json_accepted.passed} of {gemma.pass_rates.all.json_accepted.total} instead
      of {gemma.pass_rates.all.strict.passed}, and <code class="model-name" data-model="phi4-mini">phi4-mini</code> passes {phi4.pass_rates.all.json_accepted.passed} instead
      of {phi4.pass_rates.all.strict.passed}.
    </p>
    <label>
      <input type="checkbox" id="accept-json" />
      Accept JSON in code blocks
    </label>
    <figure>
      <div id="chart-scorecard"></div>
      <figcaption>
        Passes out of {summary.runs_per_prompt} runs for each prompt and model. Darker is more
        passes. Tick the box to count code-block JSON as a pass.
      </figcaption>
    </figure>
    <p>
      Across the heatmap, the general set was the easy half. Every model passed the factual,
      summary and trap prompts on all three runs, and the set as a whole passed {generalStrict} of
      its {generalTotal} answers, or {generalJson} with code-block JSON accepted. The Okun's Law set
      was harder, but two of its prompts went well across
      models: <code>okun-code</code> passed {okunCode} of {perPromptTotal}, and <code>okun-json</code> passed all {okunJsonAccepted} once
      code-block JSON is accepted ({okunJsonStrict} without).
    </p>
  </section>

  <!-- Finding 3 -->
  <section id="failure-modes">
    <h2>3. Why answers failed</h2>
    <p>
      The smaller models' fails were real errors: wrong arithmetic, the wrong economic law,
      broken code and invented data. Even passing answers could contain
      made-up facts. <code class="model-name" data-model="qwen3.5:9b">qwen3.5:9b</code> failed differently: {qwen.failure_modes.truncated} of its {qwen.pass_rates.all.strict.total - qwen.pass_rates.all.strict.passed} fails
      were answers cut off by the output limit while it was still reasoning.
    </p>
    <figure>
      <ModelKey />
      <div id="chart-failures"></div>
      <figcaption>
        Each fail was given one failure mode: its main cause. Bars show the number of fails per
        model, out of {summary.runs_per_prompt * summary.scorecard.prompts.length} answers each.
      </figcaption>
    </figure>

    <h3>In their own words</h3>
    <div class="quote-cards">
      {summary.quotes.map((q) => (
        <QuoteCard model={q.model} promptId={q.prompt_id} caption={q.caption} excerpts={q.excerpts} />
      ))}
    </div>
  </section>

  <!-- Speed and size -->
  <section id="under-the-hood">
    <h2>Speed and size</h2>
    <p>
      To produce each token, a model reads almost all of its weights from memory, so speed is
      roughly memory bandwidth ÷ model size.
    </p>
    <figure>
      <div id="chart-speed"></div>
      <figcaption>
        Each dot is one model. The dashed curve is the limit the Mac's
        memory sets: {summary.hardware.memory_bandwidth_gb_s} GB/s ÷ model size.
      </figcaption>
    </figure>
    <SpeedRace />
  </section>

  <!-- Method & limitations -->
  <details>
    <summary>Method &amp; limitations</summary>
    <h3>Method</h3>
    <ul>
      <li>
        Models ran locally through Ollama on an {summary.hardware.machine}, each at its default
        temperature, with an 8,192-token context window and a 6,144-token output limit. Each
        answered 12 prompts {summary.runs_per_prompt} times.
      </li>
      <li>
        <code class="model-name" data-model="qwen3.5:9b">qwen3.5:9b</code> ran with thinking on: it reasons before it answers, and only its
        final answer was graded.
      </li>
      <li>
        Two prompt sets: general tasks (factual recall, arithmetic, summary, JSON output, a
        trap question) and Okun's Law tasks. The Okun's Law tasks are graded against a
        regression on public FRED data, 1960–2024 (slope {summary.okun_ground_truth.slope}).
      </li>
      <li>
        Answers were graded by automatic checks, with 16 graded by hand. Each fail was given one
        failure mode: its main cause.
      </li>
    </ul>
    <h3>Limitations</h3>
    <ul>
      <li>Small sample: 12 prompts × 3 runs. A difference of a few fails is not meaningful.</li>
      <li>One machine, so timings vary between runs.</li>
      <li>Automatic checks rely on keywords and patterns, and one person did the hand grading.</li>
      <li>
        <code>okun-compute</code> asks for a regression without code, so it was designed to fail,
        and every model did.
      </li>
      <li>
        The output limit cut off {qwen.failure_modes.truncated} of <code class="model-name" data-model="qwen3.5:9b">qwen3.5:9b</code>'s
        answers mid-reasoning. A higher limit would likely raise its score, and its time per
        correct answer.
      </li>
    </ul>
    <h3>Prompts</h3>
    <p>
      Every prompt exactly as the models received it. Prompts that include the dataset or a
      regression printout scroll inside their cell.
    </p>
    <table class="prompt-table">
      <thead>
        <tr>
          <th scope="col">Prompt ID</th>
          <th scope="col">Prompt</th>
        </tr>
      </thead>
      <tbody>
        {summary.scorecard.prompts.map((p) => {
          const isLong = p.text.split('\n').length > 10;
          return (
            <tr>
              <th scope="row"><code>{p.id}</code></th>
              <td>
                {isLong ? (
                  // Focusable so keyboard users can scroll it too.
                  <pre class="scroll" tabindex="0" aria-label={`Full text of ${p.id}`}>{p.text}</pre>
                ) : (
                  <pre>{p.text}</pre>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </details>

  <!-- Links -->
  <section id="links">
    <h2>Code and data</h2>
    <ul>
      <li><a href={repoUrl}>Source code on GitHub</a></li>
      <li><a href={scorecardUrl}>Full scorecard and failure modes (scorecard.txt)</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---- Chart motion. :global because Plot builds the SVG in the browser, after Astro has
     scoped this file's styles. Everything is inside no-preference, so with reduced motion the
     charts are simply drawn. ---- */
  @media (prefers-reduced-motion: no-preference) {
    /* Bars and dots draw in once, staggered by model: one --duration-fast step per model.
       Keyframe animations, not transitions, so the highlight's opacity changes aren't delayed
       by the stagger. `backwards` holds the start state during the delay, and once finished
       the animation stops affecting the element. */
    :global(.draw-in > *) {
      transform-box: fill-box;
      animation-duration: var(--duration-slow);
      animation-timing-function: var(--ease);
      animation-fill-mode: backwards;
      animation-delay: calc(var(--order) * var(--duration-fast));
    }

    /* Bars grow from their left end, which is the baseline for every bar chart here. */
    :global(.draw-in.bars > *) {
      transform-origin: left center;
      animation-name: bar-grow;
    }

    /* Dots grow from their center as they fade in. */
    :global(.draw-in.dots > *) {
      transform-origin: center;
      animation-name: dot-in;
    }

    /* Until the chart scrolls into view, every animation waits at its start state. */
    :global(.chart-pending .draw-in > *) {
      animation-play-state: paused;
    }

    /* Heatmap cells ease to their new color when the JSON toggle flips, and fade with the
       highlight like every other mark (this rule replaces the shared transition, so it lists both). */
    :global(#chart-scorecard g[aria-label='cell'] rect) {
      transition:
        fill var(--duration-fast) var(--ease),
        opacity var(--duration-fast) var(--ease);
    }
  }

  @keyframes bar-grow {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes dot-in {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  /* Setup sections sit on a slightly darker card so they read as one block. */
  .intro-panel {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius);
  }

  /* Extra breathing room above and below the key figures row. */
  #key-figures {
    margin-block: var(--space-6);
  }

  /* Big-number tiles: 4 across on desktop, wrapping to 2 on phones. */
  .stat-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stat-tiles li {
    padding: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
  }

  .stat-tiles strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
  }

  /* Prompt table: ID column sized to its content, prompt text wrapping in the rest. */
  .prompt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prompt-table th,
  .prompt-table td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .prompt-table thead th {
    color: var(--color-muted);
    font-weight: var(--weight-semibold);
  }

  .prompt-table tbody th {
    font-weight: var(--weight-regular);
    white-space: nowrap;
  }

  .prompt-table pre {
    margin: 0;
    font-family: var(--font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Long prompts (data tables, regression output) get a fixed-height box that scrolls. */
  .prompt-table pre.scroll {
    max-height: 12rem;
    overflow-y: auto;
    padding: var(--space-2);
    background: var(--color-surface);
    border-radius: var(--radius);
  }

  /* Quote cards stacked in one column; equal rows make every card as tall as the tallest. */
  .quote-cards {
    display: grid;
    grid-auto-rows: 1fr;
    gap: var(--space-4);
  }

  /* Major-section gap after each numbered finding, so the next section starts clearly apart. */
  #accuracy-vs-time,
  #scorecard,
  #failure-modes {
    margin-bottom: var(--space-7);
  }

  /* Thin line plus a small label marking where the findings begin. */
  .results-rule {
    margin: var(--space-7) 0 var(--space-3);
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .eyebrow {
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The same rule and label under the title, with tighter spacing so the summary stays close to it. */
  .results-rule.under-title {
    margin-top: var(--space-4);
  }

  .eyebrow.under-title {
    margin-bottom: var(--space-3);
  }
</style>

<script>
  import * as Plot from '@observablehq/plot';
  import summary from '../../data/llm-lab/summary.json';

  // ---- Shared settings, read from tokens.css so the charts match the rest of the page ----
  const tokens = getComputedStyle(document.documentElement);
  const token = (name) => tokens.getPropertyValue(name).trim();
  const ink = token('--color-text');
  const paper = token('--color-bg');
  const mono = token('--font-mono');
  const modelColors = {
    'llama3.2:3b': token('--model-llama3'),
    'llama3.1:8b': token('--model-llama8'),
    'gemma3:12b': token('--model-gemma'),
    'phi4-mini': token('--model-phi4'),
    'qwen3.5:9b': token('--model-qwen'),
  };
  const modelNames = Object.keys(modelColors);

  // Options every chart shares: full column width, token fonts, muted axis text.
  // Bottom margin for any chart with an x-axis title. Plot's default is 30 and puts the title
  // 3px above the bottom edge; 38 gives it 8px more room below the tick numbers.
  const axisTitleMargin = 38;

  function base(container) {
    return {
      width: container.clientWidth,
      style: {
        background: 'transparent',
        color: token('--color-muted'),
        fontFamily: token('--font-sans'),
        fontSize: token('--text-sm'),
      },
      color: { domain: modelNames, range: Object.values(modelColors) },
    };
  }

  // Tags each element of a mark with its model (data-model), for linked highlighting.
  // With `kind`, 'bars' (grow from the left) or 'dots' (fade and scale in), the mark also draws in,
  // staggered by the model's position (0-4). `timing(d)`, if given, replaces the stagger with
  // { duration, delay } in seconds for each element, at a constant speed. Plot calls `render`
  // when it draws the mark; `next` draws it as usual, one SVG element per datum, in index order.
  const byModel = (data, kind, timing) => ({
    render(index, scales, values, dimensions, context, next) {
      const group = next(index, scales, values, dimensions, context);
      if (kind) group.classList.add('draw-in', kind);
      [...group.children].forEach((el, k) => {
        const model = data[index[k]].model;
        el.setAttribute('data-model', model);
        el.style.setProperty('--order', modelNames.indexOf(model));
        if (timing) {
          // Only takes effect where the CSS sets an animation (never under reduced motion).
          const { duration, delay } = timing(data[index[k]]);
          el.style.animationDuration = `${duration}s`;
          el.style.animationDelay = `${delay}s`;
          el.style.animationTimingFunction = 'linear';
        }
      });
      return group;
    },
  });

  // A model's dot: its color, with a thin paper-colored ring so it stays crisp on the grid.
  const modelDots = (data, x, y, channels) =>
    Plot.dot(data, {
      x, y, fill: 'model', r: 8, stroke: paper, strokeWidth: 2, channels, tip: true,
      ...byModel(data, 'dots'),
    });

  // The model's name next to its dot, so identity doesn't rely on color alone.
  // Above the dot by default; `beside` puts it to the right, for dots stacked close together.
  const modelLabels = (data, x, y, beside = false) =>
    Plot.text(data, {
      x, y, text: 'model', fill: ink, fontFamily: mono,
      ...(beside ? { dx: 14, textAnchor: 'start' } : { dy: -18 }),
      stroke: paper, strokeWidth: 4, // halo, so grid lines and curves don't cut through the text
      ...byModel(data),
    });

  // ---- Figure 1: accuracy vs time per correct answer ----
  function drawAccuracy() {
    const container = document.querySelector('#chart-accuracy');
    // Pass rate as a whole-number percentage, for the axis and tooltip.
    const data = summary.models.map((m) => ({
      model: m.name,
      passRate: Math.round((100 * m.pass_rates.all.strict.passed) / m.pass_rates.all.strict.total),
      secondsPerCorrect: m.seconds_per_correct,
    }));
    const answersPerModel = summary.models[0].pass_rates.all.strict.total;
    container.append(
      Plot.plot({
        ...base(container),
        height: 360,
        marginTop: 30,
        marginBottom: axisTitleMargin,
        // Fixed ranges with room around the data, so the dots sit inside the chart, not on its edges.
        // Log scale: times run from under 10 to almost 200 seconds, and a linear axis would
        // squash the fast models together at the left edge.
        x: {
          type: 'log',
          domain: [5, 500],
          ticks: [5, 10, 20, 50, 100, 200, 500],
          tickFormat: (d) => `${d}`,
          label: 'Seconds per correct answer →',
          grid: true,
        },
        y: {
          domain: [40, 90],
          ticks: [40, 50, 60, 70, 80, 90],
          tickFormat: (d) => `${d}%`,
          label: `↑ Pass rate (${answersPerModel} answers)`,
          grid: true,
        },
        marks: [
          modelDots(data, 'secondsPerCorrect', 'passRate'),
          // Beside the dots: llama3.2:3b and phi4-mini share an x value, so labels above would collide.
          modelLabels(data, 'secondsPerCorrect', 'passRate', true),
        ],
      }),
    );
  }

  // ---- Figure 1b: where an answer's time goes, before vs after the answer starts ----
  function drawTimeSplit() {
    const container = document.querySelector('#chart-time-split');
    const before = 'Before the answer starts';
    const writing = 'Writing the answer';
    const data = summary.models.map((m) => {
      const split = m.seconds_per_answer;
      const total = Math.round((split.before_answer + split.writing_answer) * 10) / 10;
      return {
        model: m.name,
        before: split.before_answer,
        writing: split.writing_answer,
        total,
        beforePct: Math.round((100 * split.before_answer) / total),
      };
    });
    // Shared by both segments, so hovering either one shows the whole answer's split.
    const channels = {
      Model: 'model',
      [before]: (d) => `${d.before} s (${d.beforePct}%)`,
      [writing]: (d) => `${d.writing} s`,
    };
    const tip = { format: { x1: false, x2: false, y: false, fill: false } };
    // Draw-in at each answer's own pace: every bar starts together, and each segment takes its
    // measured time × timeScale, so the slowest answer (qwen3.5:9b, ~150 s) takes 20 s.
    // The writing segment starts when the before segment finishes, like the answer itself.
    const timeScale = 20 / Math.max(...data.map((d) => d.total)); // ≈ 0.134 s per measured second
    const beforeTiming = (d) => ({ duration: d.before * timeScale, delay: 0 });
    const writingTiming = (d) => ({ duration: d.writing * timeScale, delay: d.before * timeScale });
    container.append(
      Plot.plot({
        ...base(container),
        height: modelNames.length * 40 + 70,
        marginLeft: 100,
        marginRight: 16,
        marginBottom: axisTitleMargin,
        // Room past the longest bar for its total label.
        x: { domain: [0, 180], label: 'Average seconds per answer →', grid: true },
        y: { domain: modelNames, label: null, padding: 0.3 },
        color: { domain: [before, writing], range: [token('--time-before'), token('--time-writing')], legend: true },
        marks: [
          Plot.axisY({ label: null, tickSize: 0, fontFamily: mono, fill: ink }),
          // Two segments per bar, with a 2px paper gap between them; only the data end is rounded.
          Plot.barX(data, {
            y: 'model', x1: 0, x2: 'before', fill: () => before,
            stroke: paper, strokeWidth: 2, channels, tip, ...byModel(data, 'bars', beforeTiming),
          }),
          Plot.barX(data, {
            y: 'model', x1: 'before', x2: 'total', fill: () => writing,
            stroke: paper, strokeWidth: 2, rx2y1: 4, rx2y2: 4, channels, tip, ...byModel(data, 'bars', writingTiming),
          }),
          // Total at the end of each bar.
          Plot.text(data, {
            y: 'model', x: 'total', text: (d) => `${d.total} s`,
            dx: 6, textAnchor: 'start', fill: ink, ...byModel(data),
          }),
        ],
      }),
    );
  }

  // ---- Figure 2: scorecard heatmap, redrawn when the toggle changes ----
  function drawScorecard(acceptJson) {
    const container = document.querySelector('#chart-scorecard');
    const grid = acceptJson ? summary.scorecard.json_accepted : summary.scorecard.strict;
    const prompts = summary.scorecard.prompts.map((p) => p.id);
    const runs = summary.runs_per_prompt;
    // Prompt names without their trailing number, e.g. "factual-01" -> "factual".
    const promptLabel = (id) => id.replace(/-\d+$/, '');
    const cells = modelNames.flatMap((model) =>
      prompts.map((prompt, i) => ({ model, prompt, passes: grid[model][i] })),
    );
    const options = base(container);
    // Colors before the redraw, so the new cells can start from them and transition.
    const cellsIn = (el) => el.querySelectorAll('g[aria-label="cell"] rect');
    const oldFills = [...cellsIn(container)].map((r) => r.getAttribute('fill'));
    const chart =
      Plot.plot({
        ...options,
        height: prompts.length * 34 + 50,
        marginLeft: 130,
        marginTop: 44,
        x: { domain: modelNames, axis: null, padding: 0 },
        y: { domain: prompts, axis: null, padding: 0 },
        // One hue, light to dark: more passes, darker navy. The slight curve (exponent 0.75)
        // darkens the 2/3 step enough for light text on it to pass 4.5:1 contrast.
        color: {
          type: 'pow',
          exponent: 0.75,
          domain: [0, runs],
          range: [token('--color-border'), token('--color-accent')],
          interpolate: 'lab',
        },
        marks: [
          // Model names on top, split onto two lines so they fit narrow columns on a phone.
          Plot.axisX({
            anchor: 'top', label: null, tickSize: 0, fontFamily: mono, fill: ink,
            tickFormat: (d) => d.replace(':', '\n'),
          }),
          Plot.axisY({ label: null, tickSize: 0, fontFamily: mono, fill: ink, tickFormat: promptLabel }),
          // inset leaves a 2px paper gap between neighbouring cells.
          Plot.cell(cells, {
            x: 'model', y: 'prompt', fill: 'passes', inset: 1, rx: 4,
            channels: { Model: 'model', Prompt: (d) => promptLabel(d.prompt), Passes: (d) => `${d.passes} of ${runs} runs` },
            tip: { format: { x: false, y: false, fill: false } },
            ...byModel(cells),
          }),
          Plot.text(cells, {
            x: 'model', y: 'prompt', text: (d) => `${d.passes}/${runs}`,
            // Light text on the two darkest steps, ink on the lighter ones.
            fill: (d) => (d.passes >= 2 ? paper : ink),
            ...byModel(cells),
          }),
        ],
      });
    container.replaceChildren(chart);
    // On a toggle: paint the old colors, let the browser apply them, then remove them so each
    // cell transitions to its new color (the transition is in CSS, under no-preference only).
    if (oldFills.length) {
      const rects = [...cellsIn(chart)];
      rects.forEach((r, i) => (r.style.fill = oldFills[i]));
      getComputedStyle(rects[0]).fill; // forces the browser to apply the old colors first
      rects.forEach((r) => (r.style.fill = ''));
    }
  }

  // ---- Figure 3: failure modes per model ----
  const failureLabels = {
    wrong_answer: 'Wrong answer',
    format: 'Format only',
    omission: 'Omission',
    wrong_concept: 'Wrong concept',
    contradiction: 'Contradiction',
    hallucination: 'Hallucination',
    broken_code: 'Broken code',
    no_answer: 'No answer',
    truncated: 'Cut off',
  };

  function drawFailures() {
    const container = document.querySelector('#chart-failures');
    // Every model gets a row in every group (0 when it had none), so bar positions stay fixed.
    const totals = {};
    for (const m of summary.models) {
      for (const [mode, count] of Object.entries(m.failure_modes)) {
        totals[mode] = (totals[mode] ?? 0) + count;
      }
    }
    const modes = Object.keys(totals).sort((a, b) => totals[b] - totals[a]);
    const rows = modes.flatMap((mode) =>
      summary.models.map((m) => ({
        mode: failureLabels[mode] ?? mode,
        model: m.name,
        count: m.failure_modes[mode] ?? 0,
      })),
    );
    const maxCount = Math.max(...rows.map((r) => r.count));
    const countLabels = rows.filter((r) => r.count > 0);
    container.append(
      Plot.plot({
        ...base(container),
        height: modes.length * (modelNames.length * 16 + 16) + 48, // about 16px per bar
        marginLeft: 110,
        marginBottom: axisTitleMargin,
        marginRight: 24,
        x: { domain: [0, maxCount + 1], label: 'Fails →', grid: true, ticks: 5 },
        y: { domain: modelNames, axis: null, padding: 0.1 },
        fy: { domain: modes.map((m) => failureLabels[m] ?? m), label: null, padding: 0.25 },
        marks: [
          Plot.axisFy({ anchor: 'left', label: null, tickSize: 0, fill: ink }),
          Plot.barX(rows, {
            x: 'count', y: 'model', fy: 'mode', fill: 'model',
            // Rounded at the data end, square at the baseline.
            rx2y1: 4, rx2y2: 4,
            channels: { Model: 'model' },
            tip: { format: { y: false, fill: false } },
            ...byModel(rows, 'bars'),
          }),
          // Count at the end of each bar (zeros have no bar, so no label).
          Plot.text(countLabels, {
            x: 'count', y: 'model', fy: 'mode', text: 'count',
            dx: 6, textAnchor: 'start', fill: ink, ...byModel(countLabels),
          }),
        ],
      }),
    );
  }

  // ---- Speed and size: generation speed vs model size ----
  function drawSpeed() {
    const container = document.querySelector('#chart-speed');
    const bandwidth = summary.hardware.memory_bandwidth_gb_s;
    const data = summary.models.map((m) => ({
      model: m.name,
      sizeGb: m.size_gb,
      tokensPerSecond: m.tokens_per_second,
      usedGbPerSecond: Math.round(m.size_gb * m.tokens_per_second),
    }));
    // The bandwidth limit: tokens/s = bandwidth ÷ size, drawn where it fits on the chart.
    const curve = [];
    for (let size = bandwidth / 60; size <= 10; size += 0.05) {
      curve.push({ sizeGb: size, tokensPerSecond: bandwidth / size });
    }
    container.append(
      Plot.plot({
        ...base(container),
        height: 360,
        marginTop: 30,
        marginBottom: axisTitleMargin,
        x: { domain: [0, 10], ticks: [0, 2, 4, 6, 8, 10], label: 'Model size (GB) →', grid: true },
        y: { domain: [0, 60], ticks: [0, 10, 20, 30, 40, 50, 60], label: '↑ Tokens per second', grid: true },
        marks: [
          Plot.line(curve, {
            x: 'sizeGb', y: 'tokensPerSecond',
            stroke: token('--color-muted'), strokeWidth: 2, strokeDasharray: '4 4',
          }),
          Plot.text([{ sizeGb: 10, tokensPerSecond: bandwidth / 10 }], {
            x: 'sizeGb', y: 'tokensPerSecond', text: () => `${bandwidth} GB/s ÷ size`,
            dy: -12, textAnchor: 'end', fill: token('--color-muted'),
          }),
          modelDots(data, 'sizeGb', 'tokensPerSecond', { 'GB/s used': 'usedGbPerSecond' }),
          modelLabels(data, 'sizeGb', 'tokensPerSecond'),
        ],
      }),
    );
  }

  drawAccuracy();
  drawTimeSplit();
  drawScorecard(false);
  drawFailures();
  drawSpeed();

  // Draw-in runs once per chart, the first time it scrolls into view. Until then the chart is
  // "pending": its bars and dots wait at their start state (only under no-preference, in CSS).
  const drawInCharts = ['#chart-accuracy', '#chart-time-split', '#chart-failures', '#chart-speed']
    .map((id) => document.querySelector(id));
  drawInCharts.forEach((chart) => chart.classList.add('chart-pending'));
  const drawInObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.remove('chart-pending');
        drawInObserver.unobserve(entry.target);
      }
    },
    { threshold: 0.3 }, // start once about a third of the chart is visible
  );
  drawInCharts.forEach((chart) => drawInObserver.observe(chart));

  const toggle = document.querySelector('#accept-json');
  toggle.checked = false; // browsers can restore a ticked box on reload; keep it in step with the chart
  toggle.addEventListener('change', () => {
    drawScorecard(toggle.checked);
    setHighlight(highlighted); // the redrawn cells pick up the current highlight
  });

  // ---- Linked highlighting: one model at a time, shared by every chart, the key and the text ----
  // Hover (mouse), focus (keyboard) or tap (touch) a model name, key item or chart mark. Matching
  // elements get .is-active, the rest .is-dimmed; the CSS decides what each looks like.
  let highlighted = null;
  function setHighlight(model) {
    highlighted = model;
    for (const el of document.querySelectorAll('main [data-model]')) {
      const match = el.getAttribute('data-model') === model;
      el.classList.toggle('is-active', model !== null && match);
      el.classList.toggle('is-dimmed', model !== null && !match);
    }
  }
  const modelAt = (el) => el.closest?.('[data-model]')?.getAttribute('data-model') ?? null;

  // Model names in text and key items are focusable, so keyboard users can highlight too.
  document.querySelectorAll('.model-name, .model-key li').forEach((el) => (el.tabIndex = 0));

  const main = document.querySelector('main');
  let pointerType = 'mouse';
  main.addEventListener('pointerdown', (e) => (pointerType = e.pointerType));
  main.addEventListener('pointerover', (e) => {
    if (e.pointerType === 'mouse') setHighlight(modelAt(e.target));
  });
  main.addEventListener('pointerleave', (e) => {
    if (e.pointerType === 'mouse') setHighlight(null);
  });
  // Touch and pen: a tap toggles the model on or off; a tap anywhere else clears it.
  main.addEventListener('click', (e) => {
    if (pointerType === 'mouse') return;
    const model = modelAt(e.target);
    setHighlight(model === highlighted ? null : model);
  });
  // Keyboard focus only (:focus-visible): a tap also focuses the name, and would undo its own toggle.
  main.addEventListener('focusin', (e) => {
    if (e.target.matches(':focus-visible')) setHighlight(modelAt(e.target));
  });
  main.addEventListener('focusout', (e) => {
    if (!e.relatedTarget || !main.contains(e.relatedTarget)) setHighlight(null);
  });
</script>
