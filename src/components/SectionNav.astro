---
// A list of the page's sections in the left margin, on wide screens only. The script builds it
// from every <section id> in <main> that has an h2, using the h2's text (or the section's
// data-nav-label, for a shorter label), and marks the section in view with aria-current.
// Hidden until the script fills it, so without JavaScript nothing half-built shows.
// It sits in a rail beside <main>'s column and sticks near the top of the window as the page
// scrolls, so it starts below the site header instead of on top of it.
---

<div class="section-nav-rail">
  <nav class="section-nav" aria-label="On this page" hidden>
    <ol></ol>
  </nav>
</div>

<script>
  const nav = document.querySelector('.section-nav');
  const list = nav.querySelector('ol');
  const sections = [...document.querySelectorAll('main section[id]')].filter((s) => s.querySelector('h2'));

  const links = new Map();
  for (const section of sections) {
    const link = document.createElement('a');
    link.href = `#${section.id}`;
    link.textContent = section.dataset.navLabel ?? section.querySelector('h2').textContent.trim();
    const item = document.createElement('li');
    item.append(link);
    list.append(item);
    links.set(section, link);
  }
  nav.hidden = sections.length === 0;

  // The current section is the first one crossing a band from 20% to 40% down the window.
  // Between sections (e.g. in the Method details), the last one stays marked.
  const inBand = new Set();
  const setCurrent = (section) => {
    for (const [s, link] of links) {
      if (s === section) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) inBand.add(entry.target);
        else inBand.delete(entry.target);
      }
      const first = sections.find((s) => inBand.has(s));
      if (first) setCurrent(first);
    },
    { rootMargin: '-20% 0px -60% 0px' },
  );
  sections.forEach((s) => observer.observe(s));
</script>

<style>
  /* Only where the margin beside the 46rem column fits a 13rem list, its --space-5 (2rem) gap to
     the text, and a --space-3 (1rem) gutter at the window edge: 46 + 2 × (13 + 2 + 1) = 78rem.
     If --content-width changes, change this width too.
     Media queries can't read custom properties, so the width is written out. */
  .section-nav-rail {
    display: none;
  }

  /* The rail runs the full height of <main> (which is position: relative), in the margin left of
     the column: its right edge sits --space-5 left of the text. Starting at <main>'s top keeps the
     list below the site header; sticky keeps it in view from there down. */
  @media (min-width: 78rem) {
    .section-nav-rail {
      display: block;
      position: absolute;
      top: var(--space-6); /* level with the first line of <main>, after its top padding */
      bottom: 0;
      left: calc(var(--space-3) - var(--space-5) - 13rem);
      width: 13rem;
    }

    .section-nav {
      position: sticky;
      top: var(--space-6);
    }
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
  }

  /* The items and links are made by the script, so Astro's scoped styles don't reach them;
     :global() does, kept inside .section-nav so nothing else on the page is affected. */
  .section-nav :global(li + li) {
    margin-top: var(--space-2);
  }

  /* A left bar marks each item; it turns accent for the current section. */
  .section-nav :global(a) {
    display: block;
    padding-left: var(--space-2);
    border-left: 2px solid var(--color-border);
    color: var(--color-muted);
    text-decoration: none;
  }

  .section-nav :global(a:hover) {
    color: var(--color-text);
  }

  .section-nav :global(a[aria-current]) {
    border-left-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
