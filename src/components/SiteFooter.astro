---
// The footer on every page: a short colophon (how the site is made) and when it was last built.
const repoUrl = 'https://github.com/jackrz412/jackrz412.github.io';

// Worked out at build time, so every deploy updates it. Eastern time, because GitHub's build
// machines run on UTC and would show next month for the last evening of each month.
const updated = new Date().toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'America/New_York',
});
---

<footer class="site-footer">
  <p>Set in IBM Plex · Built with Astro and Observable Plot · <a href={repoUrl}>Code on GitHub</a></p>
  <p>Updated {updated}</p>
</footer>

<style>
  /* Lined up with the text column, under a thin rule, in small muted text. */
  .site-footer {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-4) var(--space-3) var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  p {
    margin: 0;
  }

  p + p {
    margin-top: var(--space-1);
  }

  a {
    color: inherit;
  }

  a:hover {
    color: var(--color-accent);
  }
</style>
