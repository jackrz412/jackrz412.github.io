---
// The header on every page: name at left (a link home), small site links at right: About,
// Projects, GitHub, Contact.
// Projects and Contact point at the homepage's sections, so they work from any page.
import home from '../data/home.json';

// The link to the page you're on is marked aria-current, so screen readers say "current page".
// Trailing slashes are dropped before comparing, since "/about" and "/about/" are the same page.
const trim = (p: string) => p.replace(/\/$/, '');
const path = trim(Astro.url.pathname);
const current = (href: string) => (path === trim(href) ? 'page' : undefined);
---

<header class="site-header">
  <div class="inner">
    <a class="home" href="/">{home.name}</a>
    <nav aria-label="Site">
      <ul>
        <li><a href="/about/" aria-current={current('/about/')}>About</a></li>
        <li><a href="/#projects">Projects</a></li>
        <li><a href={home.contact.github}>GitHub</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* A 2px accent bar runs the full width of the window under the header. */
  .site-header {
    border-bottom: 2px solid var(--color-accent);
  }

  /* Lined up with the text column below it. Wraps on narrow phones: links drop under the name. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-4) var(--space-3);
  }

  .home {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }

  nav a[aria-current] {
    color: var(--color-accent);
  }

  .home:hover,
  nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
